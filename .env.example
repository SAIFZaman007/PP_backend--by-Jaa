# ==========================================================================
#  Peak Physique — Backend environment
# ==========================================================================
# --- Core ---
ENVIRONMENT=development                 
SECRET_KEY="change-me-run-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://peak:peak@localhost:5432/peak_physique
# For a zero-setup local run :
# DATABASE_URL=sqlite+aiosqlite:///./peak_physique.db

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174"]

# --- Frontend URLs (used in emails & Stripe redirects) ---
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# --- SMTP e-mail (transactional notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@trainpeakphysique.com
SMTP_FROM_NAME=Peak Physique
SMTP_STARTTLS=true

TRAINER_NOTIFY_EMAIL=trainer@trainpeakphysique.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Google Calendar ---
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
GOOGLE_CALENDAR_ID=primary